{
  "name": "Satu Kata",
  "description": "Satu kata besar di tengah, masuk zoom + blur. Cocok untuk hook/intro.",
  "aspect": [
    "9:16",
    "16:9"
  ],
  "tags": [
    "hook",
    "shorts"
  ],
  "font": {
    "family": "Bebas Neue",
    "size": 170,
    "uppercase": true,
    "punct": "strip",
    "letter_spacing": 2
  },
  "style": {
    "outline": 7,
    "shadow": 6,
    "shadow_x": 0,
    "shadow_y": 6,
    "shadow_color": "#000000B3"
  },
  "layout": {
    "max_words": 1,
    "max_chars": 14,
    "max_lines": 1,
    "y": 52
  },
  "timing": {
    "mode": "word",
    "min_dur": 0.25,
    "hold": 0.05,
    "fill_gaps": 0.3
  },
  "highlight": {
    "color": null
  },
  "anim": {
    "in": "zoom_blur",
    "in_dur": 0.14,
    "out": "none"
  },
  "emphasis": {
    "numbers": true,
    "color": "#FFE600"
  }
}
